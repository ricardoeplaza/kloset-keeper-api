# Database Configuration
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kloset_db

# Connection String
# This is used by Drizzle Kit (CLI) for migrations and Drizzle ORM
# The syntax ${VAR} works with NestJS ConfigModule and most modern loaders
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}